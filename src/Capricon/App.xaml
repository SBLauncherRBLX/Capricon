<Application x:Class="Capricon.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#0A0A12" />
        <SolidColorBrush x:Key="Panel" Color="#15151F" />
        <SolidColorBrush x:Key="Pink" Color="#FF2D7E" />
        <SolidColorBrush x:Key="Green" Color="#1DFF86" />
        <SolidColorBrush x:Key="Lavender" Color="#B9B4FF" />
    </Application.Resources>
</Application>
