<Window x:Class="Capricon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Capricon"
        Title="Capri"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="CapriFont">Segoe UI Black, Segoe UI, Arial</FontFamily>
    </Window.Resources>

    <Grid x:Name="Root">
        <local:AvatarView x:Name="Avatar" />

        <!-- Speech bubble: black slab with pink rim and an offset lavender ghost, like her art. -->
        <Grid x:Name="Bubble"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="10,46,0,0" MaxWidth="250"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="#B9B4FF" Margin="6,6,-6,-6" />
            <Border Background="#FFAAA0" Margin="-4,3,4,-3" Opacity="0.85" />
            <Border Background="#0A0A12" BorderBrush="#FF2D7E" BorderThickness="2.5" Padding="12,9">
                <TextBlock x:Name="BubbleText"
                           Foreground="White" TextWrapping="Wrap"
                           FontFamily="{StaticResource CapriFont}" FontSize="14" LineHeight="18" />
            </Border>
            <Border x:Name="BubbleTag" Background="#1DFF86" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="-6,-12,0,0" Padding="6,1">
                <TextBlock Text="CAPRI" Foreground="#0A0A12" FontFamily="{StaticResource CapriFont}" FontSize="10" />
            </Border>
        </Grid>

        <!-- Chat line, shown by double-click or Ctrl+Alt+C. -->
        <Grid x:Name="Chat"
              VerticalAlignment="Bottom" HorizontalAlignment="Center"
              Margin="0,0,0,28" Width="290" Visibility="Collapsed">
            <Border Background="#1DFF86" Margin="5,5,-5,-5" />
            <Border Background="#0A0A12" BorderBrush="#FF2D7E" BorderThickness="2.5">
                <Grid>
                    <TextBox x:Name="ChatBox"
                             Background="Transparent" Foreground="White" CaretBrush="#1DFF86"
                             SelectionBrush="#FF2D7E" BorderThickness="0" Padding="8,7"
                             FontFamily="Segoe UI" FontSize="14"
                             KeyDown="ChatBox_KeyDown" TextChanged="ChatBox_TextChanged" />
                    <TextBlock x:Name="ChatHint"
                               Text="Скажи что-нибудь, чумба…"
                               Foreground="#88FFFFFF" Margin="11,8,0,0"
                               FontFamily="Segoe UI" FontSize="14" IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
